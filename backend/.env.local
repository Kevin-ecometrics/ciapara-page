# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend (Next.js en dev)
CORS_ORIGIN=http://localhost:3000

# ─── MySQL / XAMPP phpMyAdmin ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=database_name

# ─── Nodemailer / SMTP ────────────────────────────────────────────────────────
SMTP_HOST=smtp.host.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@host.com
SMTP_PASS=tu_app_password

# Correo donde llegan los mensajes del formulario
EMAIL_TO=admin@tudominio.com